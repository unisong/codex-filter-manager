  {
    "name": "default configuration passes history unchanged",
    "ctx": {
      "protocol": "responses",
      "path": "/v1/responses"
    },
    "options": {},
    "request": {
      "model": "demo/gpt-6-astra",
      "reasoning": {
        "effort": "high"
      },
      "include": [
        "reasoning.encrypted_content",
        "message.output_text.logprobs"
      ],
      "input": [
        {
          "type": "reasoning",
          "id": "rs_old",
          "encrypted_content": "foreign"
        },
        {
          "type": "message",
          "id": "msg_old",
          "role": "assistant",
          "content": [
            {
              "type": "output_text",
              "text": "Keep answer."
            },
            {
              "type": "encrypted_content",
              "data": "foreign"
            }
          ]
        },
        {
          "type": "function_call",
          "id": "fc_old",
          "call_id": "pair",
          "name": "lookup",
          "arguments": "{\"id\":\"business\"}"
        },
        {
          "type": "function_call_output",
          "id": "out_old",
          "call_id": "pair",
          "output": "keep result"
        },
        {
          "type": "message",
          "role": "user",
          "content": [
            {
              "type": "input_file",
              "file_id": "file_keep"
            }
          ]
        }
      ]
    }
  },
